# Copia este archivo como `.env.local` y pon los valores de tu proyecto de
# Supabase (Project Settings -> API Keys). Los mismos dos valores hay que
# cargarlos en Vercel: Settings -> Environment Variables.
#
# Sin estas variables la app sigue funcionando, pero solo con los enlaces
# largos `#e=`: no habra codigos de 6 caracteres.
#
# La clave que va aqui es la PUBLICABLE (`anon`). Esa se puede exponer.
# La clave secreta (`service_role`) NO debe usarse en este proyecto.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
